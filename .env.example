# ---------------------------------------------------------------------------
# Copy to .env and fill in. Never commit the real .env.
#
#   cp .env.example .env
#   python -c "import secrets; print(secrets.token_hex(32))"        -> SECRET_KEY
#   python -m app.security keygen                                    -> FIELD_ENCRYPTION_KEY
# ---------------------------------------------------------------------------

# --- required ---------------------------------------------------------------
# Signs session tokens. Changing it logs everyone out.
SECRET_KEY=change-me-to-a-long-random-string

# --- database ---------------------------------------------------------------
# Postgres + pgvector is the production target. Omit entirely to fall back to a
# local SQLite file, which runs the full application with no database server.
DATABASE_URL=postgresql+psycopg://twin:twin-dev-password@localhost:5432/cognitive_twin
POSTGRES_USER=twin
POSTGRES_PASSWORD=twin-dev-password
POSTGRES_DB=cognitive_twin
POSTGRES_PORT=5432
DB_ECHO=false

# --- privacy ----------------------------------------------------------------
# Fernet key encrypting free-text decision data at rest. Strongly recommended:
# a decision history is a record of how someone thinks. Losing this key makes
# the encrypted fields unreadable, so back it up separately from the database.
FIELD_ENCRYPTION_KEY=
AUDIT_LOG_ENABLED=true
# 0 keeps data until the user deletes it.
DATA_RETENTION_DAYS=0

# --- LLM reasoning layer (entirely optional) --------------------------------
# Without a key the system still runs: the LLM layer reports itself unavailable
# and its weight is redistributed across the other layers. Scenario text is
# only ever sent when the individual account has also opted in.
ANTHROPIC_API_KEY=
LLM_ENABLED=true
LLM_MODEL=claude-sonnet-5
LLM_MAX_TOKENS=1600
LLM_TIMEOUT_SECONDS=45

# --- embeddings -------------------------------------------------------------
# "hashing" is deterministic, offline and needs no downloads.
# "sentence-transformers" gives richer similarity if the package is installed.
EMBEDDING_BACKEND=hashing
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- learning ---------------------------------------------------------------
# Below this many decisions the statistical layer is not fitted at all.
MIN_DECISIONS_FOR_ML=12
RETRIEVAL_TOP_K=5
RETRAIN_EVERY_N_OUTCOMES=5

# --- application ------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,https://duplicate-brain.onrender.com
ACCESS_TOKEN_EXPIRE_MINUTES=720
BACKEND_PORT=8000
FRONTEND_PORT=3000

# --- frontend ---------------------------------------------------------------
NEXT_PUBLIC_API_URL=https://duplicate-brain.onrender.com/api/v1
